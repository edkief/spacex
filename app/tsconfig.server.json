{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": { "@shared/*": ["./src/shared/*"], "@server/*": ["./src/server/*"] }
  },
  "include": ["src/server", "src/shared"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/client"]
}
