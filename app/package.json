{
  "name": "drift-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Drift — multiplayer space/on-foot/surface game (scaffold TASK-68).",
  "scripts": {
    "dev": "concurrently -n vite,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "snapshot:update": "tsx scripts/gen-stars-full-fixture.ts && tsx scripts/gen-system-star1-fixture.ts && tsx scripts/gen-surface-fixture.ts && tsx scripts/gen-surface-chunk10-fixture.ts && tsx scripts/gen-surface-chunk01-fixture.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write ."
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
