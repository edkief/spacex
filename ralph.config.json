{
  "maxIterations": 100,
  "pinTask": true,
  "timeouts": {
    "iterationMs": 2700000,
    "inactivityMs": 600000,
    "wrapUpMs": 1200000
  },
  "retries": {
    "providerRetriesPerIteration": 3,
    "iterationRetries": 1,
    "backoffMs": 15000
  },
  "stall": {
    "maxUnproductiveIterations": 3,
    "onRepeatedTimeout": "split"
  },
  "permissions": {
    "fallback": "allow",
    "deny": ["git push", "git remote", "rm -rf /", "shutdown", "reboot"]
  },
  "log": {
    "format": "text",
    "level": "info"
  },
  "git": {
    "push": "iteration",
    "remote": "origin"
  },
  "ui": {
    "actions": "open",
    "host": "0.0.0.0"
  },
  "metrics": {
    "cost": {
      "estimator": "power",
      "currency": "$AU",
      "power": {
        "watts": 220, 
        "pricePerKwh": 0.24,
        "models": { "ollama/qwen3:8b": { "watts": 180 } }
      }
    }
  }
}
