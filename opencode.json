{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama-Local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6:35b-a3b-q4_K_M": {
          "name": "Qwen 3.6 TS-Specialist",
          "tool_calling": true,
          "context_length": 100000
        }
      }
    },
    "i4790k": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Llama-CPP-i4790k",
      "options": {
        "baseURL": "http://host.docker.internal:8080/v1"
      },
      "models": {
        "i4790k-120k": {
          "name": "Local - 120k Context",
          "tool_calling": true,
          "context_length": 120000
        }
      }
    },
    "llama-cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Llama-CPP-Local",
      "options": {
        "baseURL": "http://host.docker.internal:8080/v1"
      },
      "models": {
        "local-60k": {
          "name": "Local - 60k Context",
          "tool_calling": true,
          "context_length": 60000
        },
        "local-150k": {
          "name": "Local - 150k Context",
          "tool_calling": true,
          "context_length": 150000
        },
        "local-200k": {
          "name": "Local - 200k Context",
          "tool_calling": true,
          "context_length": 200000
        }
      }
    }
  },
  "plugin": [
    "./plugins/caveman/plugin.js"
  ],
  "mcp": {
    "localhost-3100": {
      "type": "remote",
      "url": "http://localhost:3100/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:MCP_3100_TOKEN}"
      }
    }
  }
}
