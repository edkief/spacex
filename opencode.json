{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama-cpp/local-150k",
  "provider": {
    "gufo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "gufo",
      "options": {
        "baseURL": "http://localhost:8888/v1"
      },
      "models": {
        "Qwen3.8 Flash Next": { 
          "name": "Local - 150k Context",
          "tool_calling": true,
          "context_length": 150000
	}
      }
    },
    "llama-cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Llama-CPP-Local",
      "options": {
        "baseURL": "http://llama-chat.llama:8080/v1"
      },
      "models": {
        "local-150k": {
          "name": "Local - 150k Context",
          "tool_calling": true,
          "context_length": 150000
	}
      }
    }
  },
  "plugin": [
    "./plugins/caveman/plugin.js"
  ],
  "mcp": {
    "localhost-3100": {
      "type": "remote",
      "url": "http://localhost:3100/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:MCP_3100_TOKEN}"
      }
    }
  }
}
